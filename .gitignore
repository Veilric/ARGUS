# ==============================================================================
# ARGUS by Veilric — Git Ignore Rules
# ==============================================================================

# Local Network Configuration Baselines
# Persistent machine-specific baseline profiles created at runtime
config/*
!config/.gitkeep

# Session Event & Operational Logs
# Rotating logs created during active monitoring and discovery
logs/*
!logs/.gitkeep

# Generated Diagnostic & Incident Reports
# User-generated network reports containing local internal network data
reports/*
!reports/.gitkeep

# Temporary & Working Files
*.tmp
*.bak
*~
*.swp
*.swo
.~lock.*
.#*

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test & Coverage Outputs
*.test
*.out
coverage.*
